{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://kelurahan-cibubur-production.up.railway.app/api/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "https://kelurahan-cibubur-production.up.railway.app/uploads/$1"
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
